// BookLeaf Author Support Portal — data model.
//
// Design notes
// - Users are the authentication principal; an Author profile hangs off a User 1:1.
//   Admins are Users without an Author profile.
// - Category/priority are stored twice on a ticket: the *effective* values (what the
//   queue uses) and the *AI suggestion*. Keeping the AI's original answer lets us
//   measure override rate (a cheap proxy for classification accuracy).
// - Internal notes and author-visible replies share one table, separated by
//   `visibility`, so the conversation stays a single ordered timeline.
// - Money is stored as Decimal(12,2) INR; never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AUTHOR
  ADMIN
}

/// Production pipeline from the BookLeaf knowledge base, in order.
enum BookStage {
  MANUSCRIPT_RECEIVED
  EDITING
  COVER_DESIGN
  TYPESETTING
  PROOFREADING
  ISBN_ASSIGNMENT
  PRINTING
  DISTRIBUTION_SETUP
  PUBLISHED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION_AVAILABILITY
  BOOK_STATUS_PRODUCTION
  GENERAL_INQUIRY
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// Who decided the current category/priority value.
enum DecisionSource {
  AI
  RULES
  ADMIN
}

enum TriageState {
  PENDING // waiting for (or retrying) triage
  AI // classified by the LLM
  FALLBACK // LLM unavailable; rule-based classifier used
}

enum MessageVisibility {
  PUBLIC // visible to the author
  INTERNAL // admin-only note
}

/// How an admin reply was produced — lets us track AI draft adoption.
enum ReplyOrigin {
  MANUAL
  AI_DRAFT_UNEDITED
  AI_DRAFT_EDITED
}

enum AiTask {
  TRIAGE
  DRAFT
}

enum AiCallOutcome {
  SUCCESS
  ERROR
  SKIPPED // circuit open or AI disabled — fallback used without calling the API
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author          Author?
  messages        TicketMessage[]
  assignedTickets Ticket[]         @relation("TicketAssignee")
  activities      TicketActivity[]
}

model Author {
  id         String   @id @default(cuid())
  code       String   @unique // dataset id, e.g. AUTH001
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String?
  city       String?
  joinedDate DateTime @db.Date

  books   Book[]
  tickets Ticket[]
}

model Book {
  id                    String    @id @default(cuid())
  code                  String    @unique // dataset id, e.g. BK001
  authorId              String
  author                Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title                 String
  isbn                  String    @unique
  genre                 String
  stage                 BookStage
  publicationDate       DateTime? @db.Date
  mrp                   Decimal?  @db.Decimal(12, 2)
  royaltyPerCopy        Decimal?  @db.Decimal(12, 2)
  totalCopiesSold       Int       @default(0)
  totalRoyaltyEarned    Decimal   @default(0) @db.Decimal(12, 2)
  royaltyPaid           Decimal   @default(0) @db.Decimal(12, 2)
  royaltyPending        Decimal   @default(0) @db.Decimal(12, 2)
  lastRoyaltyPayoutDate DateTime? @db.Date
  printPartner          String?
  availableOn           String[]

  tickets Ticket[]

  @@index([authorId])
}

model Ticket {
  id          String       @id @default(cuid())
  number      Int          @unique @default(autoincrement()) // human reference: BL-1001
  authorId    String
  author      Author       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bookId      String? // null = "General / Account level"
  book        Book?        @relation(fields: [bookId], references: [id], onDelete: SetNull)
  subject     String
  description String
  status      TicketStatus @default(OPEN)

  // Effective classification (drives the queue)
  category       TicketCategory?
  categorySource DecisionSource?
  priority       TicketPriority?
  prioritySource DecisionSource?

  // AI triage output, kept even after an admin override
  triageState  TriageState     @default(PENDING)
  aiCategory   TicketCategory?
  aiPriority   TicketPriority?
  aiConfidence Float?
  aiSummary    String? // one-line summary for queue scanning
  aiRationale  String?
  triagedAt    DateTime?

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  firstResponseAt DateTime?
  resolvedAt      DateTime?
  lastActivityAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages    TicketMessage[]
  attachments Attachment[]
  drafts      AiDraft[]
  activities  TicketActivity[]
  aiCalls     AiCallLog[]

  @@index([status, priority, createdAt])
  @@index([authorId, createdAt])
  @@index([assigneeId])
  @@index([triageState])
}

model TicketMessage {
  id         String            @id @default(cuid())
  ticketId   String
  ticket     Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User              @relation(fields: [senderId], references: [id])
  body       String
  visibility MessageVisibility @default(PUBLIC)
  origin     ReplyOrigin       @default(MANUAL)
  draftId    String? // set when the reply started from an AI draft
  createdAt  DateTime          @default(now())

  @@index([ticketId, createdAt])
}

model Attachment {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String // path relative to the upload directory
  createdAt   DateTime @default(now())
}

/// One row per generated draft. The latest row is the "current" draft; it is
/// considered stale once newer author messages exist (see `basedOnMessageCount`).
model AiDraft {
  id                  String   @id @default(cuid())
  ticketId            String
  ticket              Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body                String
  internalActions     String[] // follow-ups the draft commits BookLeaf to (e.g. "trigger stock re-sync")
  model               String // model id, or "template" when generated offline
  fallbackReason      String? // why the template was used (disabled, rate_limited, timeout...)
  basedOnMessageCount Int // number of PUBLIC messages the draft accounted for
  createdAt           DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Audit trail of state changes (status, overrides, assignment).
model TicketActivity {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String? // null = system (AI triage)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String // e.g. status_changed, category_overridden
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Every LLM call (or skipped call) is logged for cost and reliability tracking.
model AiCallLog {
  id               String        @id @default(cuid())
  ticketId         String?
  ticket           Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  task             AiTask
  model            String
  outcome          AiCallOutcome
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  cacheReadTokens  Int           @default(0)
  cacheWriteTokens Int           @default(0)
  costUsd          Decimal       @default(0) @db.Decimal(10, 6)
  latencyMs        Int           @default(0)
  errorType        String?
  createdAt        DateTime      @default(now())

  @@index([task, createdAt])
}
