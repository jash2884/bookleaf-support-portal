# Copy to server/.env (the API reads its env from the server workspace).

# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bookleaf:bookleaf@localhost:5432/bookleaf?schema=public
# Long random string. Used to sign session JWTs. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Only needed when the client is served from a different origin than the API.
CORS_ORIGIN=

# --- AI (server-side only; never exposed to the browser) ---
# Provider: "gemini" or "anthropic". If unset, whichever key is present is used.
# With no key at all the app runs in "AI offline" mode: rule-based triage + template drafts.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (defaults per provider):
#   gemini:    triage gemini-3.5-flash-lite, drafts gemini-3.5-flash, fallbacks gemini-3.5-flash-lite,gemini-flash-latest
#   anthropic: triage claude-haiku-5-5,      drafts claude-opus-5-5
# AI_TRIAGE_MODEL=
# AI_DRAFT_MODEL=
# AI_FALLBACK_MODELS=
AI_DRAFT_EFFORT=low
AI_TIMEOUT_MS=30000
