# Copy to server/.env (the API reads its env from the server workspace).

# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bookleaf:bookleaf@localhost:5432/bookleaf?schema=public
# Long random string. Used to sign session JWTs. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Only needed when the client is served from a different origin than the API.
CORS_ORIGIN=

# --- AI (server-side only; never exposed to the browser) ---
# Leave empty to run in "AI offline" mode: rule-based triage + template drafts.
ANTHROPIC_API_KEY=
# Triage = classification + priority (high volume, structured output).
AI_TRIAGE_MODEL=claude-haiku-5-5
# Drafts = author-facing replies (quality matters most here).
AI_DRAFT_MODEL=claude-opus-5-5
AI_DRAFT_EFFORT=low
AI_TIMEOUT_MS=30000
